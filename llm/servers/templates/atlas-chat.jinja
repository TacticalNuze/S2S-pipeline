{#- Gemma 2 chat format for Atlas-Chat, replacing the template embedded in the GGUF.
    The original raises an error on any system message and whenever roles don't strictly
    alternate user/assistant; pipecat sends both (system prompt + a system greeting
    instruction, and consecutive user turns after an interruption).
    Here every system message is merged, in order, into the start of the first user turn
    (Gemma has no system role), and repeated roles are written as separate turns. -#}
{{- bos_token -}}
{%- set ns = namespace(system='', pending=true) -%}
{%- for message in messages -%}
    {%- if message['role'] == 'system' -%}
        {%- set ns.system = ns.system + (message['content'] | trim) + '\n\n' -%}
    {%- endif -%}
{%- endfor -%}
{%- for message in messages -%}
    {%- if message['role'] != 'system' -%}
        {%- set role = 'model' if message['role'] == 'assistant' else 'user' -%}
        {%- if ns.pending and ns.system -%}
            {%- if role == 'user' -%}
                {{- '<start_of_turn>user\n' + ns.system + (message['content'] | trim) + '<end_of_turn>\n' -}}
            {%- else -%}
                {{- '<start_of_turn>user\n' + (ns.system | trim) + '<end_of_turn>\n' -}}
                {{- '<start_of_turn>model\n' + (message['content'] | trim) + '<end_of_turn>\n' -}}
            {%- endif -%}
        {%- else -%}
            {{- '<start_of_turn>' + role + '\n' + (message['content'] | trim) + '<end_of_turn>\n' -}}
        {%- endif -%}
        {%- set ns.pending = false -%}
    {%- endif -%}
{%- endfor -%}
{#- Only system messages (e.g. the bot's greeting instruction): send them as the user turn. -#}
{%- if ns.pending and ns.system -%}
    {{- '<start_of_turn>user\n' + (ns.system | trim) + '<end_of_turn>\n' -}}
{%- endif -%}
{%- if add_generation_prompt -%}
    {{- '<start_of_turn>model\n' -}}
{%- endif -%}
